@startuml M1_casos_de_uso
' Figura 1: actores del problema y casos de uso. CU1 a CU4 producen el dato;
' CU5 a CU9 forman el ámbito del análisis retrospectivo de la gravedad.
skinparam dpi 200
skinparam defaultFontSize 17
skinparam shadowing false
skinparam packageStyle rectangle
left to right direction
skinparam usecase {
  BackgroundColor #F5F5F5
  BorderColor #333333
}

actor "Ente de control\n(Policía, CTE,\nmunicipios)" as EC
actor "ANT" as ANT
actor "INEC" as INEC
actor "Gobierno autónomo\ndescentralizado" as GAD

usecase "CU1 Registrar el parte\nen el sitio" as CU1
usecase "CU2 Asignar la\ncausa probable" as CU2
usecase "CU3 Consolidar y publicar\nla base acumulada" as CU3
usecase "CU4 Publicar los\ntotales oficiales" as CU4

rectangle "Análisis retrospectivo de la gravedad\n(ámbito del problema)" {
  usecase "CU5 Identificar las circunstancias\nasociadas a siniestros graves" as CU5
  usecase "CU6 Clasificar la gravedad\nde un siniestro registrado" as CU6
  usecase "CU7 Verificar la correspondencia\ncon las cifras oficiales" as CU7
  usecase "CU8 Distinguir la información\ndisponible al levantar el parte" as CU8
  usecase "CU9 Medir el aporte de\nla causa probable" as CU9
}

EC --> CU1
EC --> CU2
ANT --> CU3
INEC --> CU4
ANT --> CU5
GAD --> CU5
ANT --> CU6
GAD --> CU6
CU7 <-- INEC

CU5 ..> CU7 : <<include>>
CU5 ..> CU8 : <<include>>
CU6 ..> CU7 : <<include>>
CU6 ..> CU8 : <<include>>
CU9 ..> CU6 : <<extend>>
@enduml

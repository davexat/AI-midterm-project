@startuml M3_actividad
' Figura 3: cómo se produce y circula el dato del siniestro, con las
' excepciones que condicionan el análisis como ramas del flujo.
skinparam dpi 200
skinparam defaultFontSize 16
skinparam shadowing false
skinparam activity {
  BackgroundColor #F5F5F5
  BorderColor #333333
  DiamondBackgroundColor #F5F5F5
}

|Ente de control|
start
:Atender el siniestro en el sitio;
:Levantar el parte: fecha, hora, lugar,\ntipo de siniestro y vehículos (conjunto A);
if (¿algún campo\nsin dato?) then (sí)
  :Registrar el campo como\n"ND" o "no identificado";
else (no)
endif
:Registrar a los participantes\ny su condición (desenlace);
if (¿la persona fallece\ndespués del evento?) then (sí)
  :Mantenerla registrada\ncomo "LESIONADO";
else (no)
endif
:Investigar y asignar la causa\nprobable (conjunto B);
:Enviar el parte a la ANT;

|ANT|
:Consolidar los partes\nde los 16 entes de control;
note right
  El archivo conserva los defectos
  de origen: escrituras distintas,
  identificadores repetidos
  y valores "ND".
end note
:Publicar el archivo acumulado del año;
|INEC|
:Procesar los mismos registros;
:Publicar los totales trimestrales;
|Gobierno autónomo descentralizado|
:Consultar el archivo y los totales;
if (¿los totales responden qué\ncircunstancias se asocian\ncon fallecidos en sitio?) then (no)
  :Necesidad no cubierta: relacionar\nlas circunstancias del parte\ncon la gravedad registrada;
else (sí)
endif
stop
@enduml

@startuml M4_estados
' Figura 4: ciclo de vida del registro y qué información existe en cada estado.
skinparam defaultFontSize 16
skinparam shadowing false
skinparam state {
  BackgroundColor #F5F5F5
  BorderColor #333333
}

[*] --> Ocurrido
Ocurrido --> AtendidoEnSitio : el ente de control llega al lugar
AtendidoEnSitio --> ParteLevantado : se registra el parte\n(fecha, hora, lugar, tipo, vehículos,\nparticipantes y condición)
ParteLevantado --> CausaAsignada : termina la investigación
CausaAsignada --> Consolidado : la ANT valida y consolida
Consolidado --> Publicado : corte al 30/09/2026
Publicado --> [*]

state ParteLevantado {
  ParteLevantado : T_parte = instante del proyecto
  ParteLevantado : información del conjunto A
  ParteLevantado : el recuento de víctimas ya existe,\npero no se usa como entrada
}
state CausaAsignada {
  CausaAsignada : T_causa = instante del conjunto B
  CausaAsignada : se conoce la causa probable
}
@enduml
